# Copy to .env (never commit .env). SWAPI needs no API key, so there are no secrets here.
PORT=3000

# live     = call swapi.dev (cached + throttled), fall back to the local snapshot if it fails
# snapshot = never touch the network (same as `npm run dev:offline`)
DATA_SOURCE=live
SWAPI_BASE=https://swapi.dev/api

# Be polite to a free public API
CACHE_TTL_SECONDS=86400
MIN_INTERVAL_MS=300
UPSTREAM_TIMEOUT_MS=8000

# GraphQL safety limits (see src/graphql/limits.js)
MAX_QUERY_DEPTH=6
MAX_QUERY_COST=5000

# Our own API's rate limit, per client IP. One "Film credits" race is about 140 requests.
RATE_LIMIT_PER_MINUTE=1500
